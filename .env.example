SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # Service Role Key (not anon key)

SQLALCHEMY_DATABASE_URL=     # postgresql+asyncpg://user:password@host:port/db

# Shared secret between the bot and this backend (must equal the bot's BACKEND_SECRET).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TELEGRAM_WEBHOOK_SECRET=

# Generate the same way as above.
ADMIN_JWT_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
# Production only (Hugging Face blocks api.telegram.org): relay admin notifications through the bot.
# Leave unset locally so the backend sends directly with TELEGRAM_BOT_TOKEN.
BOT_NOTIFY_URL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

ENVIRONMENT=development

# Prices in Birr (must be the same in the backend and the bot)
PRO_PRICE_BIRR=300
DUAL_DEPT_PRICE_BIRR=150
